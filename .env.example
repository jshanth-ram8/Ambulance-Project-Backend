# Environment variables for the backend. Set these in your hosting dashboard (or `export` them locally).

# --- Frontend (required in production) ---
# Public URL of the deployed frontend. Comma-separate to allow several (e.g. production + a preview URL).
FRONTEND_URL=https://your-frontend.vercel.app

# --- Session cookie ---
# Needed in production when the frontend and backend are on DIFFERENT domains. Both must be served over HTTPS.
# Leave unset for local development (defaults: lax / false).
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# --- First administrator account (created once, only if no admin exists) ---
ADMIN_EMAIL=admin@ambulance.com
ADMIN_PASSWORD=change-me

# --- Database (optional: without these the app uses a local SQLite file) ---
# SQLite on most hosts is wiped on every restart/deploy, so use MySQL for data you want to keep.
# SPRING_PROFILES_ACTIVE=mysql
# DB_URL=jdbc:mysql://<host>:<port>/<dbname>?useSSL=true
# DB_USER=
# DB_PASSWORD=

# PORT is set by most hosts automatically (defaults to 8080).
